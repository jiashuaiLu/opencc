{
  "name": "opencc",
  "version": "2.0.0",
  "description": "OpenCC - Claude Code 代理服务管理工具（开源版）",
  "main": "dist/main/index.js",
  "author": "OpenCC Team",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "preview": "vite preview",
    "electron:dev": "npm run build:main && concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:dist": "electron-builder",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\""
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "claude",
    "proxy"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^41.5.2",
    "electron-builder": "^25.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "terser": "^5.46.2",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "@iarna/toml": "^2.2.5",
    "@types/adm-zip": "^0.5.7",
    "@types/iarna__toml": "^2.0.5",
    "@types/tar": "^6.1.13",
    "adm-zip": "^0.5.16",
    "antd": "^5.20.0",
    "axios": "^1.16.0",
    "chart.js": "^4.4.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.3",
    "express": "^4.18.0",
    "form-data": "^4.0.5",
    "framer-motion": "^12.35.0",
    "http-proxy-middleware": "^2.0.6",
    "keytar": "^7.9.0",
    "lowdb": "^7.0.1",
    "react": "^18.3.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",
    "recharts": "^3.7.0",
    "tar": "^7.5.10",
    "winston": "^3.14.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zustand": "^4.5.0"
  },
  "build": {
    "appId": "com.opencc.app",
    "productName": "OpenCC",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": true
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ]
  }
}
